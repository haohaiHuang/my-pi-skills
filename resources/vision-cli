#!/usr/bin/env node
/**
 * vision-cli — 跨平台"读图转文字"服务（通用版）
 *
 * 用途：当前 agent 模型无视觉能力时，把图片交给本机可用的视觉模型识别，返回文字。
 * 用法：vision-cli <图片路径> [问题]
 *
 * 模型发现（不硬编码）：
 *   1. 优先按 ~/.config/vision-cli/config.json 的 preferredModels 顺序
 *   2. 否则自动扫描 ~/.pi/agent/models.json + auth.json，收集所有 input 含 image 的模型
 *   3. 按顺序尝试，失败自动换下一个；全部失败或无视觉模型 → 明确提示
 */

const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const { execFileSync } = require("node:child_process");

const CONFIG_PATH = path.join(os.homedir(), ".config", "vision-cli", "config.json");
const PI_MODELS = path.join(os.homedir(), ".pi", "agent", "models.json");
const PI_AUTH = path.join(os.homedir(), ".pi", "agent", "auth.json");
const PI_STORE = path.join(os.homedir(), ".pi", "agent", "models-store.json");
const DEFAULT_QUESTION = "请详细描述这张图片的内容：主体、文字（逐字输出）、布局、颜色、风格等，尽量完整。";

// ---------- 读取配置（preferredModels 可选） ----------
function loadConfig() {
  if (!fs.existsSync(CONFIG_PATH)) return {};
  try { return JSON.parse(fs.readFileSync(CONFIG_PATH, "utf-8")); } catch { return {}; }
}

// ---------- 发现本机所有视觉模型 ----------
// 来源1: ~/.pi/agent/models.json 的 providers；来源2: models-store.json（key 从 auth.json 查）
// 返回 [{ provider, model, baseUrl, apiKey }]，按 preferredModels 顺序优先
function discoverVisionModels(preferred) {
  const models = [];
  const seen = new Set();
  let auth = {};
  let piModels = { providers: {} };
  let store = {};

  try { auth = JSON.parse(fs.readFileSync(PI_AUTH, "utf-8")); } catch {}
  try { piModels = JSON.parse(fs.readFileSync(PI_MODELS, "utf-8")); } catch {}
  try { store = JSON.parse(fs.readFileSync(PI_STORE, "utf-8")); } catch {}

  const add = (provider, m, baseUrl, apiKey) => {
    if (!apiKey) return;
    const input = m.input || m.capabilities?.input || [];
    if (!input.includes("image")) return;
    const key = `${provider}/${m.id}`;
    if (seen.has(key)) return;
    seen.add(key);
    models.push({ provider, model: m.id, baseUrl, apiKey });
  };

  // 来源1: models.json providers
  for (const [provider, cfg] of Object.entries(piModels.providers || {})) {
    const apiKey = cfg.apiKey || auth[provider]?.key;
    if (!apiKey) continue;
    const baseUrl = cfg.baseUrl;
    for (const m of cfg.models || []) add(provider, m, baseUrl, apiKey);
  }

  // 来源2: models-store.json providers（key 从 auth.json 查）
  for (const [provider, entry] of Object.entries(store)) {
    const apiKey = auth[provider]?.key || piModels.providers?.[provider]?.apiKey;
    if (!apiKey) continue;
    const baseUrl = entry.baseUrl;
    for (const m of entry.models || []) add(provider, m, m.baseUrl || baseUrl, apiKey);
  }

  // 按 preferredModels 排序（未指定的排后面，保持原顺序）
  if (Array.isArray(preferred) && preferred.length > 0) {
    models.sort((a, b) => {
      const ai = preferred.indexOf(`${a.provider}/${a.model}`);
      const bi = preferred.indexOf(`${b.provider}/${b.model}`);
      return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
    });
  }
  return models;
}

// ---------- 图片 → base64 data URL ----------
function toDataUrl(imgPath) {
  const ext = path.extname(imgPath).toLowerCase();
  const mime = {
    ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
    ".gif": "image/gif", ".webp": "image/webp", ".bmp": "image/bmp",
    ".heic": "image/heic", ".heif": "image/heif",
  }[ext] || "image/png";
  return `data:${mime};base64,${fs.readFileSync(imgPath).toString("base64")}`;
}

// ---------- 参数解析：<图片> [问题] [--context 历史] [--format text|json] [--deep] ----------
function parseArgs(args) {
  let imgPath = null;
  const question = [];
  let context = null;
  let format = "text";
  let deep = false;
  for (let i = 0; i < args.length; i++) {
    if (args[i] === "--context") { context = args[++i] || null; continue; }
    if (args[i] === "--format") { format = args[++i] || "text"; continue; }
    if (args[i] === "--deep") { deep = true; continue; }
    if (!imgPath) imgPath = args[i];
    else question.push(args[i]);
  }
  return { imgPath, question: question.join(" "), context, format, deep };
}

// ---------- 调视觉模型（openai-completions 兼容） ----------
async function askVision(m, imgPath, question, context, format) {
  const url = `${m.baseUrl}/chat/completions`;
  const content = [];
  // 多轮会话：带上之前的问答历史（明确是同一张图的追问，防止模型困惑）
  if (context && context.trim()) {
    content.push({ type: "text", text: `这是对同一张图片的连续提问，图片没有改变。你之前对该图内容的回答是：\n${context.trim()}\n现在用户有新问题，请基于你之前对这张图的观察直接回答新问题（不要质疑图片是否一致，不要重复已答内容，只需补充新问题的信息）。` });
  }
  content.push({ type: "text", text: question });
  content.push({ type: "image_url", image_url: { url: toDataUrl(imgPath) } });
  if (format === "json") {
    content.push({ type: "text", text: "\n请以 JSON 格式输出（不要 Markdown 代码块）。适合提取清单时参考：{\"summary\":\"总述\",\"items\":[{\"text\":\"...\"}]}" });
  }
  const body = {
    model: m.model,
    messages: [{ role: "user", content }],
    max_tokens: 1500,
  };
  // API 级强制 JSON（部分模型不支持，失败时降级为纯提示词引导）
  if (format === "json") body.response_format = { type: "json_object" };
  const resp = await fetch(url, {
    method: "POST",
    headers: { "Content-Type": "application/json", Authorization: `Bearer ${m.apiKey}` },
    body: JSON.stringify(body),
  });
  if (!resp.ok) {
    // 模型不支持 response_format → 去掉重试（提示词引导仍有效）
    if (format === "json" && resp.status === 400) {
      delete body.response_format;
      const retry = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${m.apiKey}` },
        body: JSON.stringify(body),
      });
      if (retry.ok) {
        const data = await retry.json();
        const text = data?.choices?.[0]?.message?.content;
        if (text) return text.trim();
      }
      const errText = await retry.text().catch(() => "");
      throw new Error(`HTTP ${retry.status}: ${errText.slice(0, 200)}`);
    }
    const errText = await resp.text().catch(() => "");
    throw new Error(`HTTP ${resp.status}: ${errText.slice(0, 200)}`);
  }
  const data = await resp.json();
  const text = data?.choices?.[0]?.message?.content;
  if (!text) throw new Error("模型无返回内容");
  return text.trim();
}

// ---------- 自主理解模式（--deep）：脚本内多轮读图直到理解，输出综合报告 ----------
// 第1轮：整体理解；第2轮：按需求定向抓细节；第3轮：综合输出最终报告
async function deepVision(m, imgPath, need) {
  const r1 = await askVision(m, imgPath,
    `请详细描述整张图片：布局结构、全部文字内容、所有元素、视觉风格。` +
    (need ? `\n重点关注需求：${need}` : ""));
  const r2 = await askVision(m, imgPath,
    `基于你刚才对整张图的观察，针对需求「${need || "全面理解"}」补充关键细节：数据、价格、按钮、状态、层级关系等容易被整体描述忽略的信息。`,
    r1);
  const r3 = await askVision(m, imgPath,
    `综合你前两轮对同一张图的观察，输出一份完整的图片理解报告，按以下结构组织（不要遗漏重要内容）：\n1. 概述\n2. 布局结构\n3. 内容细节（全部文字/数据）\n4. 交互元素（按钮/标签/状态）\n5. 视觉风格\n这是最终报告，直接输出正文。`,
    `${r1}\n\n【第二轮补充】\n${r2}`);
  return r3;
}

// ---------- 主流程 ----------
async function main() {
  const { imgPath, question, context, format, deep } = parseArgs(process.argv.slice(2));
  if (!imgPath) {
    console.error("用法: vision-cli <图片路径> [问题] [--context 历史] [--format text|json] [--deep]");
    process.exit(1);
  }
  const q = question || DEFAULT_QUESTION;

  if (!fs.existsSync(imgPath)) {
    console.error(`图片不存在: ${imgPath}`);
    process.exit(1);
  }
  // heic 转 png（部分模型不支持 heic）
  let usePath = imgPath;
  if (/\.heic$/i.test(imgPath)) {
    const tmp = path.join(os.tmpdir(), `vision-${Date.now()}.png`);
    execFileSync("sips", ["-s", "format", "png", imgPath, "--out", tmp], { stdio: "ignore" });
    usePath = tmp;
  }

  const cfg = loadConfig();
  const preferred = cfg.preferredModels || [];
  const models = discoverVisionModels(preferred);

  if (models.length === 0) {
    console.error(
      "[vision-cli] 未找到可用的视觉模型。\n" +
      "  检查：~/.pi/agent/models.json 中是否有 input 含 image 的模型且配了 apiKey，\n" +
      "  或用 ~/.config/vision-cli/config.json 的 preferredModels 指定（provider/model 格式）。"
    );
    process.exit(1);
  }

  const used = [];
  for (const m of models) {
    used.push(`${m.provider}/${m.model}`);
    try {
      const text = deep
        ? await deepVision(m, usePath, q)
        : await askVision(m, usePath, q, context, format);
      if (used.length > 1) console.log(`[vision-cli 用 ${m.provider}/${m.model}]\n${text}`);
      else console.log(text);
      return;
    } catch (e) {
      console.error(`[vision-cli] ${m.provider}/${m.model} 失败: ${e.message}`);
    }
  }

  console.error(`[vision-cli] 所有视觉模型都失败（尝试过: ${used.join(", ")}）`);
  process.exit(1);
}

main();
